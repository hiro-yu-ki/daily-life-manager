{
  "name": "hibi-log",
  "version": "1.0.0",
  "private": true,
  "description": "個人向けの日常記録アプリ (TAGU-23)",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node tests/app.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "server": "node server/index.js",
    "check": "node --check src/domain.js && node --check src/services.js && node --check server/index.js && node tests/app.test.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-constants": "~18.0.0",
    "expo-notifications": "~0.32.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {},
  "engines": { "node": ">=20" }
}
